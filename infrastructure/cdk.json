{
    "app": "python3 infrastructure/app.py",
    "watch": {
        "include": ["**"],
        "exclude": [
            "README.md",
            "cdk*.json",
            "requirements*.txt",
            "**/.*",
            "tests"
        ]
    },
    "context": {
        "@aws-cdk/core:enableStackNameDuplicates": "true",
        "aws-cdk:enableDiffNoFail": "true"
    }
}
